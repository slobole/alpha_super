# Template for the wired strict-HPI S&P 500 IBS/RSI-exit POD.
# Copy to alpha/live/releases/<client_id>/<pod_id>.yaml and edit the copy only.
identity:
  release_id: your_user.pod_hpi_sp500_ibs_rsi_exit.daily_moo.v1
  user_id: your_user
  pod_id: pod_hpi_sp500_ibs_rsi_exit_01

deployment:
  mode: paper
  enabled_bool: false

broker:
  account_route: DU_YOUR_PAPER_ACCOUNT
  host_str: 127.0.0.1
  port_int: 7497
  client_id_int: 31
  timeout_seconds_float: 4.0

strategy:
  strategy_import_str: strategies.hpi.strategy_mr_hpi_sp500_ibs_rsi_exit
  data_profile_str: norgate_eod_sp500_hpi_pit
  params:
    benchmark_symbol_str: "$SPXTR"
    start_date_str: "1998-01-01"
    backtest_start_date_str: "2004-01-01"
    indexname_str: "S&P 500"
    max_positions_int: 10
    slippage_float: 0.00025
    commission_per_share_float: 0.005
    commission_minimum_float: 1.0

market:
  session_calendar_id_str: XNYS

schedule:
  signal_clock_str: eod_snapshot_ready
  execution_policy_str: next_open_moo

execution:
  pod_budget_fraction_float: 0.03
  auto_submit_enabled_bool: false

bootstrap:
  initial_cash_float: 100000.0

risk:
  risk_profile_str: standard_equity_mr
